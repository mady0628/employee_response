# Local npm-run development. Copy to the repository root as .env.
# Start PostgreSQL and RabbitMQ locally; these hostnames are not for Docker containers.
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sales_reminder
DB_USER=sales_app
DB_PASSWORD=local-dev-only-change-me
DB_SSL=false
RABBITMQ_PASSWORD=local-dev-only-change-me
RABBITMQ_URL=amqp://sales_app:local-dev-only-change-me@127.0.0.1:5672

INTERNAL_API_KEY=local-dev-only-change-me
IDENTITY_INTERNAL_API_KEY=local-dev-identity-key-change-before-production
CONFIG_INTERNAL_API_KEY=local-dev-config-key-change-before-production
TELEGRAM_CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GATEWAY_INTERNAL_API_KEY=local-dev-gateway-key-change-before-production
CONVERSATION_ADMIN_API_KEY=local-dev-conversation-key-change-before-production
WA_INTERNAL_API_KEY=local-dev-whatsapp-key-change-before-production
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_DASHBOARD_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

IDENTITY_SERVICE_URL=http://127.0.0.1:3001
CONFIG_SERVICE_URL=http://127.0.0.1:3002
CONVERSATION_SERVICE_URL=http://127.0.0.1:3004
SLA_SERVICE_URL=http://127.0.0.1:3005
GATEWAY_SERVICE_URL=http://127.0.0.1:3003
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=local-dev-telegram-secret-change-me
# Set a public HTTPS tunnel URL to receive Telegram webhooks during local development.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_CONNECTION_ID=1
LARK_APP_ID=REPLACE_WITH_REAL_LARK_APP_ID
LARK_APP_SECRET=REPLACE_WITH_REAL_LARK_APP_SECRET
LARK_VERIFICATION_TOKEN=local-dev-lark-verification-token
LARK_ENCRYPT_KEY=
LARK_CONNECTION_ID=2
WHATSAPP_CONNECTION_ID=3
WA_INTERNAL_HOST=127.0.0.1
WA_INTERNAL_PORT=3013
WA_REMINDER_ENABLED=true
WA_GROUP_IDS=
WA_AUTO_ACTIVATE_GROUPS=false
WA_LOG_QR=true

WEBHOOK_RATE_LIMIT=600
INTERNAL_RATE_LIMIT=120
ADMIN_API_RATE_LIMIT=120
API_RATE_LIMIT=120
VERIFICATION_CODE_RATE_LIMIT=100
WA_INTERNAL_RATE_LIMIT=60
SLA_TIMEOUT_MINUTES=10
REMINDER_INTERVAL_MINUTES=10
INBOX_BUFFER_SECONDS=10
REACTION_BUFFER_SECONDS=15
REMINDER_POLL_INTERVAL_MS=5000
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_BYTES=10485760
TRUST_PROXY_HOPS=0
